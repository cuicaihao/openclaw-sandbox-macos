# OpenClaw Sandbox Environment Configuration
# Copy this file to .env and modify as needed

# Local User ID and Group ID (Default: 501:20 for macOS)
# Run `id -u` and `id -g` to find your values
OPENCLAW_UID=501
OPENCLAW_GID=20

# Ollama API Key (Default: ollama)
# Use this if your Ollama instance is behind a proxy that requires authentication
OLLAMA_API_KEY=ollama
